# Porta do servidor (local)
PORT=3000

# URL pública canônica usada nos links/QR codes do painel. Recomendada em
# produção para não depender de headers de proxy. Sem barra no final.
# PUBLIC_ORIGIN=https://seu-dominio.exemplo

# --- Controle de acesso ----------------------------------------------------

# "open"   = qualquer um entra (padrão; é o que mantém o demo público de pé)
# "locked" = só entra com link de convite gerado no /admin
ACCESS_MODE=open

# Senha do painel /admin. SEM ela o painel não abre — um admin aberto poderia
# gerar links de acesso pra qualquer um.
ADMIN_PASSWORD=troque-esta-senha

# Segredo que assina os cookies de sessão. Precisa ser FIXO entre deploys,
# senão todo mundo é deslogado a cada publicação. Use algo longo e aleatório:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ACCESS_SECRET=

# --- Onde os links ficam guardados ----------------------------------------
# Sem isso, os links vivem na memória do processo — o que só serve pra rodar
# local. Em serverless (Vercel) o processo morre o tempo todo e o vínculo
# "esse link é daquele aparelho" sumiria junto, furando a proteção.
# Conecte um Vercel KV / Upstash Redis e cole as duas variáveis:
KV_REST_API_URL=
KV_REST_API_TOKEN=

# --- Upload de ROM pelo painel admin ----------------------------------------
# Sem isso, "Adicionar jogo" fica desligado em produção (a Vercel só deixa
# escrever em /tmp, que não sobrevive nem a um cold start — subir um arquivo
# ali e ele sumir no próximo deploy seria pior que não ter a função). Em
# dev local funciona sem essa variável, gravando em public/roms/private/ e
# public/covers/private/ (fora do git).
#
# Ativa em: projeto na Vercel → aba Storage → Create Database → Blob.
# A variável abaixo é preenchida sozinha quando você conecta o Blob store ao
# projeto; normalmente não precisa colar isso à mão.
BLOB_READ_WRITE_TOKEN=

# --- Emulador --------------------------------------------------------------

# CDN do EmulatorJS (dados do core WASM). Só troque se for hospedar você mesmo.
EMULATORJS_CDN_URL=https://cdn.emulatorjs.org/4.2.3/data/

# Override pontual de ROM sem editar config/keychains.json.
# Padrão: GAMEURL_<ID EM MAIÚSCULO, NÃO-ALFANUMÉRICO VIRA "_">
# GAMEURL_FLAPPYBIRD_NES=https://exemplo.com/outra-rom.nes

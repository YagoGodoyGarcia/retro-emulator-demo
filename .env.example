# Porta do servidor (local)
PORT=3000

# --- Controle de acesso ----------------------------------------------------

# "open"   = qualquer um entra (padrão; é o que mantém o demo público de pé)
# "locked" = só entra com link de convite gerado no /admin
ACCESS_MODE=open

# Senha do painel /admin. SEM ela o painel não abre — um admin aberto poderia
# gerar links de acesso pra qualquer um.
ADMIN_PASSWORD=troque-esta-senha

# Segredo que assina os cookies de sessão. Precisa ser FIXO entre deploys,
# senão todo mundo é deslogado a cada publicação. Use algo longo e aleatório:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ACCESS_SECRET=

# --- Onde os links ficam guardados ----------------------------------------
# Sem isso, os links vivem na memória do processo — o que só serve pra rodar
# local. Em serverless (Vercel) o processo morre o tempo todo e o vínculo
# "esse link é daquele aparelho" sumiria junto, furando a proteção.
# Conecte um Vercel KV / Upstash Redis e cole as duas variáveis:
KV_REST_API_URL=
KV_REST_API_TOKEN=

# --- Emulador --------------------------------------------------------------

# CDN do EmulatorJS (dados do core WASM). Só troque se for hospedar você mesmo.
EMULATORJS_CDN_URL=https://cdn.emulatorjs.org/stable/data/

# Override pontual de ROM sem editar config/keychains.json.
# Padrão: GAMEURL_<ID EM MAIÚSCULO, NÃO-ALFANUMÉRICO VIRA "_">
# GAMEURL_FLAPPYBIRD_NES=https://exemplo.com/outra-rom.nes

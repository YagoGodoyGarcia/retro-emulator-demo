# Porta do servidor Express
PORT=3000

# CDN do EmulatorJS (dados do core WASM). Só troque se for hospedar você mesmo.
EMULATORJS_CDN_URL=https://cdn.emulatorjs.org/stable/data/

# Override pontual de ROM sem editar config/keychains.json.
# Padrão da variável: GAMEURL_<KEYID EM MAIUSCULO, NAO-ALFANUMERICO VIRA "_">
# Exemplo pro keyId "flappybird-nes":
# GAMEURL_FLAPPYBIRD_NES=https://exemplo.com/outra-rom.nes
